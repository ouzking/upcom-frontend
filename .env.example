# =============================================================================
# upcom-frontend — variables d'environnement (valeurs PUBLIQUES uniquement)
# Dev : copier vers .env.development.local — build local de production : .env.production.local (ignorés par Git).
# ⚠ Ne pas utiliser .env.local : il est aussi chargé par les builds de production.
# ⛔ Ne jamais mettre la service_role / clé secrète Supabase ici.
# =============================================================================

# Projet Supabase partagé avec upcom-backend et upcom-admin
# Local : `npm run db:start` dans upcom-backend affiche l'URL et la clé publishable.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (l'ancienne clé « anon » est acceptée via VITE_SUPABASE_ANON_KEY)

# URL publique définitive du site (canonical, Open Graph, sitemap.xml, robots.txt)
VITE_SITE_URL=https://www.upcomagency.com

# Cloudflare Turnstile — à renseigner si TURNSTILE_SECRET_KEY est configuré côté Edge Functions
VITE_TURNSTILE_SITE_KEY=
